APP_NAME=Arthub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Railway provee estas variables automaticamente al agregar PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# URL del frontend (para CORS) — pon la URL real de Railway
FRONTEND_URL=https://your-frontend.up.railway.app
