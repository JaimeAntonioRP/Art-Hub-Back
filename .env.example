APP_NAME=Arthub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Railway provee estas variables automaticamente al agregar PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Correo: recuperación de contraseña y avisos de revisión a los artistas.
# Con "log" los correos se escriben en storage/logs. En producción configura el
# proveedor elegido (Resend, Amazon SES o SMTP) con MAIL_MAILER y sus credenciales.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-responder@arthub.pe
MAIL_FROM_NAME="${APP_NAME}"

# Almacenamiento (config/arthub.php). El disco del servidor se borra en cada deploy:
# en producción usa Cloudflare R2 con un bucket público (imágenes) y uno privado
# (expediente documental).
MEDIA_DISK=public
DOCUMENTS_DISK=local
# MEDIA_DISK=r2_media
# DOCUMENTS_DISK=r2_documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_MEDIA_BUCKET=arthub-media
R2_MEDIA_URL=https://media.arthub.pe
R2_DOCUMENTS_BUCKET=arthub-documentos

# Administrador inicial: el seeder lo crea solo si no existe (no cambia su contraseña)
ADMIN_EMAIL=admin@arthub.pe
ADMIN_PASSWORD=

# URL del frontend (para CORS) — pon la URL real de Railway
FRONTEND_URL=https://your-frontend.up.railway.app
