# .env del backend en el VPS. Copiar a /var/www/arthub-back/.env y completar.
# Nunca subir el .env real al repositorio.

APP_NAME=ArtHub
APP_ENV=production
# Copiar el APP_KEY del servidor actual (Railway/Render). Si es una instalación nueva: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.TU_DOMINIO
# Dominio del sitio público: va en los correos, el CORS y el QR impreso en cada certificado.
FRONTEND_URL=https://TU_DOMINIO

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arthub
DB_USERNAME=arthub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# Nada se envía en segundo plano: correos y PDF se generan al momento.
QUEUE_CONNECTION=sync

# En el VPS el disco no se borra al actualizar: los archivos pueden quedarse aquí
# (con respaldo, ver DESPLIEGUE.md). Para usar Cloudflare R2: r2_media / r2_documents y las R2_*.
MEDIA_DISK=public
DOCUMENTS_DISK=local

# Correo (ejemplo con Resend por SMTP; con otro proveedor cambian host, usuario y clave).
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@TU_DOMINIO
MAIL_FROM_NAME="${APP_NAME}"

# Administrador inicial: el seeder lo crea solo si no existe.
ADMIN_EMAIL=admin@TU_DOMINIO
ADMIN_PASSWORD=
